<idea-plugin>
    <id>qemu</id>
    <name>QEMU for CLion</name>
    <version>2.0.0</version>
    <description>Run QEMU virtual machines from CLion, including ARM Linux images and GDB stub support.</description>
    <vendor url="https://github.com/toshaTikhonov/qemu-for-clion">QEMU for CLion contributors</vendor>
    <depends>com.intellij.modules.clion</depends>
    <extensions defaultExtensionNs="com.intellij">
        <configurationType implementation="pl.merskip.qemu.QemuConfigurationType"/>
        <programRunner implementation="pl.merskip.qemu.QemuRunner"/>
    </extensions>
</idea-plugin>
